# N16R8 (16MB Quad Flash + 8MB Octal PSRAM) configuration for ESP32-S3-DevKitC-1
# Equivalent to the qio_opi flash/PSRAM mode used in the earlier Arduino-framework labs.

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
